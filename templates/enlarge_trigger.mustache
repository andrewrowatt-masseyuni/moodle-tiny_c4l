{{!
    @template tiny_c4l/enlarge_trigger

    Icon button overlaid on the top right of a table or image, which opens it enlarged.
    Added to rendered content by tiny_c4l/enlarge.

    Context variables required for this template:
    * label - Tooltip and accessible name

    Example context (json):
    {
        "label": "Enlarge table"
    }
}}
<button type="button" class="tiny-c4l-enlarge-btn" title="{{label}}" aria-label="{{label}}">{{#pix}} e/fullscreen, core {{/pix}}</button>
