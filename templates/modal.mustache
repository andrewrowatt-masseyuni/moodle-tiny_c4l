{{!
    @template tiny_c4l/modal

    Modal to manage components within the Tiny Editor.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:

    Example context (json):
    {
        "elementid": "exampleId",
        "filters" : [
            {"name": "Contextual"},
            {"type": "contextual"},
            {"filterClass": ""}
        ],
        "buttons": [
          {"id": "randomid"},
          {"imageClass": "c4l-classname"},
          {"name": "component name"},
          {"htmlcode": "<div>Text</div>"}
        ],
        "preview": "true"
    }
}}
{{< core/modal }}
    {{$title}}
        {{#str}} pluginname, tiny_c4l {{/str}}
    {{/title}}
    {{$body}}
        <div id="{{elementid}}" class="c4l-plugin-container">
            <div class="c4l-select-filters">
                <select class="c4l-select-filter" aria-controls="c4l-buttons-grid">
                    {{#filters}}
                        <option value="{{type}}">{{name}}</option>
                    {{/filters}}
                </select>
            </div>
            <div class="c4l-buttons-filters">
                {{#filters}}
                    <button class="c4l-button-filter {{filterClass}}" data-filter="{{type}}" aria-controls="c4l-buttons-grid">
                            {{name}}
                    </button>
                {{/filters}}
            </div>
            <div class="c4l-buttons-preview {{^preview}}c4l-no-preview{{/preview}}">
                <div id="c4l-buttons-grid" class="c4l-buttons-grid">
                    {{#buttons}}
                        <button
                            class="c4lt-dialog-button {{imageClass}}"
                            data-id="{{id}}"
                            data-type="{{type}}"
                            data-classcomponent="{{classComponent}}"
                            data-moreinformation="{{moreinformation}}"
                        >
                            {{#moreinformation}}
                            <a href="{{moreinformation}}" target="_blank" class="c4l-info-icon" title="{{#str}} mu-moreinformationabout, tiny_c4l,{{name}}{{/str}}" aria-label="{{#str}} mu-moreinformationabout, tiny_c4l,{{name}}{{/str}}"><span class="sr-only">{{#str}} mu-moreinformationabout, tiny_c4l,{{name}}{{/str}}</span></a>
                            {{/moreinformation}}
                            <span class="c4l-button-text">
                                {{#icon}}
                                    <i class="icon" style="background-image: url({{icon}});"></i>
                                {{/icon}}
                                {{{name}}}
                            </span>
                            <span class="c4l-button-variants">
                            {{#variants}}
                                <span
                                    class="c4l-button-variant {{imageClass}}"
                                    data-variant="{{name}}"
                                    data-state="{{state}}"
                                    data-toggle="tooltip"
                                    data-placement="top"
                                    title="{{title}}"
                                ></span>
                            {{/variants}}
                            </span>
                        </button>
                    {{/buttons}}
                </div>
                {{#preview}}
                    <div class="c4l-code-preview">
                        <div class="c4l-text-preview">{{#str}} preview, tiny_c4l {{/str}}</div>
                        <div data-id="code-preview-default">
                            <div class="c4l-preview-default">{{#str}} previewdefault, tiny_c4l {{/str}}</div>
                        </div>
                        {{#buttons}}
                            <div data-id="code-preview-{{id}}" data-moreinformation="{{moreinformation}}" class="c4l-component-code {{#css}}c4l-component-custom-code{{/css}} c4l-hidden" role="presentation" style="{{css}}">
                                <div class="c4l-component-preview-wrapper">
                                    {{{htmlcode}}}
                                </div>
                            </div>
                        {{/buttons}}
                    </div>
                {{/preview}}
            </div>
        </div>
    {{/body}}
    {{$footer}}
        <div class="c4l-clipboard-buttons">
            <button type="button" class="btn btn-sm btn-secondary c4l-clipboard-cut" id="c4l-clipboard-cut" 
                    title="{{#clipboardCutEnabled}}{{#str}} mu-clipboard_cut_enabled, tiny_c4l {{/str}}{{/clipboardCutEnabled}}{{^clipboardCutEnabled}}{{#str}} mu-clipboard_cut_disabled, tiny_c4l {{/str}}{{/clipboardCutEnabled}}">
                {{#pix}} icon, tiny_c4l {{/pix}}
                {{#str}} mu-clipboard_cut, tiny_c4l {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-secondary c4l-clipboard-copy" id="c4l-clipboard-copy"
                    title="{{#clipboardCopyEnabled}}{{#str}} mu-clipboard_copy_enabled, tiny_c4l {{/str}}{{/clipboardCopyEnabled}}{{^clipboardCopyEnabled}}{{#str}} mu-clipboard_copy_disabled, tiny_c4l {{/str}}{{/clipboardCopyEnabled}}">
                {{#pix}} icon, tiny_c4l {{/pix}}
                {{#str}} mu-clipboard_copy, tiny_c4l {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-secondary c4l-clipboard-paste" id="c4l-clipboard-paste"
                    title="{{#clipboardPasteEnabled}}{{#str}} mu-clipboard_paste_enabled, tiny_c4l {{/str}}{{/clipboardPasteEnabled}}{{^clipboardPasteEnabled}}{{#str}} mu-clipboard_paste_disabled, tiny_c4l {{/str}}{{/clipboardPasteEnabled}}">
                {{#pix}} icon, tiny_c4l {{/pix}}
                {{#str}} mu-clipboard_paste, tiny_c4l {{/str}}
            </button>
        </div>
    {{/footer}}
{{/ core/modal }}
{{#js}}
    require(['jquery'], function($) {
      $('[data-toggle="tooltip"]').tooltip();
    });
{{/js}}
