{{!
    @template tiny_c4l/enlarge_image

    Body of the enlarged image modal. tiny_c4l/enlarge fills in the image, counter and link,
    and updates them as the student steps through the images on the page.

    Context variables required for this template:
    * gallery - True when there is more than one image to step through

    Example context (json):
    {
        "gallery": true
    }
}}
<div class="tiny-c4l-enlarge-image">
    <a class="tiny-c4l-enlarge-original" data-region="original" href="#" target="_blank" rel="noopener">
        {{#pix}} i/externallink, core {{/pix}}{{#str}} enlarge_original, tiny_c4l {{/str}}
        <span class="sr-only">{{#str}} opensinnewwindow {{/str}}</span>
    </a>
    <div class="tiny-c4l-enlarge-stage">
        {{#gallery}}
        <button type="button" class="btn btn-secondary rounded-circle tiny-c4l-enlarge-nav" data-action="previous"
            title="{{#str}} enlarge_previous, tiny_c4l {{/str}}" aria-label="{{#str}} enlarge_previous, tiny_c4l {{/str}}">
            {{#pix}} i/previous, core {{/pix}}
        </button>
        {{/gallery}}
        <img class="tiny-c4l-enlarge-img" data-region="image" src="" alt="">
        {{#gallery}}
        <button type="button" class="btn btn-secondary rounded-circle tiny-c4l-enlarge-nav" data-action="next"
            title="{{#str}} enlarge_next, tiny_c4l {{/str}}" aria-label="{{#str}} enlarge_next, tiny_c4l {{/str}}">
            {{#pix}} i/next, core {{/pix}}
        </button>
        {{/gallery}}
    </div>
    {{#gallery}}
    <p class="tiny-c4l-enlarge-position" data-region="position" aria-live="polite"></p>
    {{/gallery}}
</div>
